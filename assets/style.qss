QMainWindow, QDialog { background: #111017; }
QWidget { color: #f4f0fa; font-family: 'Inter'; font-size: 13px; }
QWidget#content, QScrollArea, QScrollArea > QWidget > QWidget { background: transparent; }
QFrame#sidebar { background: rgba(17, 15, 24, 225); border-right: 1px solid #383041; }
QFrame#identity { background: rgba(38, 31, 51, 215); border: 1px solid #51415f; border-radius: 22px; }
QLabel#brand { font-size: 19px; font-weight: 600; }
QLabel#workspaceTitle { font-size: 24px; font-weight: 600; }
QLabel#eyebrow { color: #a69ab8; font-size: 10px; font-weight: 600; }
QLabel#muted { color: #b0a7c0; font-size: 12px; }
QLabel#body { color: #d0c6dd; font-size: 13px; }
QLabel#name { font-size: 30px; font-weight: 600; }
QLabel#nameSmall { font-size: 19px; font-weight: 500; }
QLabel#headline { font-size: 15px; font-weight: 600; }
QLabel#level { font-size: 36px; font-weight: 600; color: #e9d5c0; }
QLabel#deviceValue { font-size: 21px; font-weight: 500; color: #d0bdff; }
QLabel#badge { background: #2d263b; color: #c3b4da; border: 1px solid #51425f; border-radius: 8px; padding: 5px 8px; font-size: 10px; }
QLabel#badge[tone="success"] { background: #243a31; color: #a5dfbd; border-color: #46634f; }
QLabel#status { color: #d0bdff; }
QLabel#status[error="true"] { color: #f3aab8; }
QLabel#banner { background: #332a45; border: 1px solid #635076; border-radius: 12px; padding: 12px 14px; color: #e5d7fa; }
QLabel#banner[error="true"] { background: #40252f; border-color: #845265; color: #f8cad4; }
QFrame#panel { background: rgba(29, 26, 38, 225); border: 1px solid #44394f; border-radius: 18px; }
QFrame#panel[role="session"] { background: rgba(43, 33, 48, 240); border: 1px solid #70535e; border-radius: 20px; }
QLineEdit { background: #1d1926; border: 1px solid #4b3f59; border-radius: 12px; padding: 11px 12px; selection-background-color: #6854a1; }
QLineEdit:focus { border-color: #b7a1ff; background: #272132; }
QLineEdit:hover { border-color: #8d75aa; }
QLineEdit:disabled { color: #81778e; }
QPushButton { background: #292633; border: 1px solid #4c425c; border-radius: 11px; padding: 9px 13px; }
QPushButton:hover { background: #463c56; border-color: #a18ab8; }
QPushButton:pressed { background: #211c2a; }
QPushButton:disabled { color: #81778e; border-color: #34303f; }
QPushButton#primary { font-weight: 600; }
QListWidget { background: transparent; border: 0; outline: 0; }
QListWidget#activity { color: #b0a7c0; font-size: 12px; }
QListWidget#activity::item { padding: 8px 2px; border-bottom: 1px solid #3d3349; }
QListWidget#activity::item:selected { background: #423452; color: #f4f0fa; }
QListWidget#activity::item:hover { background: #33293f; }
QScrollBar:vertical { background: transparent; width: 6px; margin: 3px 0; }
QScrollBar::handle:vertical { background: #594b69; border-radius: 3px; min-height: 28px; }
QScrollBar::handle:vertical:hover { background: #9c83b5; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background: transparent; }
QProgressBar { border: 0; background: #45364d; height: 4px; max-height: 4px; border-radius: 2px; }
QProgressBar::chunk { background: #f0bf95; border-radius: 2px; }
QCheckBox { spacing: 9px; }
QCheckBox:hover { color: #e5d5ff; }
QCheckBox::indicator { width: 17px; height: 17px; border-radius: 5px; border: 1px solid #776389; background: #211b2d; }
QCheckBox::indicator:checked { background: #b7a1ff; border-color: #ded1ff; }
QCheckBox::indicator:hover { border-color: #e0caff; }
QCheckBox::indicator:focus { border: 2px solid #e4d8ff; }
QToolTip { background: #2d243a; color: #f4f0fa; border: 1px solid #79638e; padding: 7px; }
